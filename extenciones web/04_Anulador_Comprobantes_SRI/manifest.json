{
  "manifest_version": 3,
  "name": "Anulador de Comprobantes SRI",
  "version": "2.2.0",
  "description": "Llena automáticamente la solicitud de anulación de comprobantes electrónicos del SRI (Ecuador), extrayendo los datos de tus PDFs.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://srienlinea.sri.gob.ec/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/pdf.worker.mjs",
        "libs/pdf.mjs"
      ],
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ]
    }
  ]
}