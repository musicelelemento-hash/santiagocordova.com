{
  "manifest_version": 3,
  "name": "💎 [SC SUITE COMERCIAL v3.0] Anulador de Comprobantes SRI",
  "version": "3.0.0",
  "description": "Edición comercial con interfaz Glassmorphism y animaciones. Llena automáticamente la solicitud de anulación de comprobantes electrónicos del SRI y procesa envíos en bucle.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://srienlinea.sri.gob.ec/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "libs/injected_bypass.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/pdf.worker.mjs",
        "libs/pdf.mjs",
        "libs/injected_bypass.js"
      ],
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ]
    }
  ]
}