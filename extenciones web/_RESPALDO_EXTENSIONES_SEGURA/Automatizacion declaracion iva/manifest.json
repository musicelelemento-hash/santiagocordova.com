{
    "manifest_version": 3,
    "name": "SRI Extractor - Facturas",
    "version": "1.0.0",
    "description": "Extrae y suma facturas del portal SRI (con IVA y sin IVA)",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://srienlinea.sri.gob.ec/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://srienlinea.sri.gob.ec/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}