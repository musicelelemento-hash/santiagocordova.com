{
  "manifest_version": 3,
  "name": "SRI Llenador - Anulación de Comprobantes",
  "version": "1.0",
  "description": "Llenador automático para solicitud de anulación de comprobantes. Soluciones Tributarias Estratégicas - Santiago Córdova.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images.png",
      "48": "images.png",
      "128": "images.png"
    }
  },
  "icons": {
    "16": "images.png",
    "48": "images.png",
    "128": "images.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/pdf.worker.mjs",
        "libs/pdf.worker.js",
        "libs/pdf.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}