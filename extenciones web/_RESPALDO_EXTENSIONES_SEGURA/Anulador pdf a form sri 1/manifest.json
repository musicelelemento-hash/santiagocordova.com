{
  "manifest_version": 3,
  "name": "⚡ [SC MOTOR PRO] Anulador SRI — Llenador & Envío Bucle",
  "version": "2.5.0",
  "description": "Motor oficial de anulación de comprobantes SRI: extracción de PDFs, auto-llenado con clave de 49 dígitos, confirmación y envío automático en bucle. Santiago Córdova.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images.png",
      "48": "images.png",
      "128": "images.png"
    }
  },
  "icons": {
    "16": "images.png",
    "48": "images.png",
    "128": "images.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://srienlinea.sri.gob.ec/comprobantes-electronicos-internet/*",
        "*://srienlinea.sri.gob.ec/tuportal-internet/*"
      ],
      "js": [
        "libs/injected_bypass.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://srienlinea.sri.gob.ec/comprobantes-electronicos-internet/*",
        "*://srienlinea.sri.gob.ec/tuportal-internet/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/pdf.worker.mjs",
        "libs/pdf.mjs",
        "libs/injected_bypass.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}